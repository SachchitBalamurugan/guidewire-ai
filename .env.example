# Everything runs on this device by default. None of these are required.

# Speech to text (faster-whisper). tiny | base | small | medium
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Translation: NLLB-200 distilled 600M converted to CTranslate2 (HF repo id or local folder)
NLLB_MODEL=JustFrederik/nllb-200-distilled-600M-ct2-int8

# Suggestions + insights: ollama (on-device, default) | rules (no model) | gemini (cloud fallback)
LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_S=25

# Only used when LLM_BACKEND=gemini (pip install google-genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Load Whisper and NLLB at startup instead of on the first utterance
PRELOAD_MODELS=1
# Write a JSONL log per tour to logs/
DEBUG=0
